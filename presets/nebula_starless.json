{
  "name": "nebula_starless",
  "description": "Nebula processed without stars, stars added back smaller. Built-in star removal; swap in stars.starnet when StarNet is configured.",
  "steps": [
    {
      "plugin": "crop.auto"
    },
    {
      "plugin": "cosmetic.hot_pixels"
    },
    {
      "plugin": "background.poly",
      "params": {
        "degree": 2
      }
    },
    {
      "plugin": "color.neutralize_background"
    },
    {
      "plugin": "color.white_balance_stars"
    },
    {
      "plugin": "color.fix_saturated"
    },
    {
      "plugin": "noise.wavelet"
    },
    {
      "plugin": "stretch.auto",
      "params": {
        "target": 0.08,
        "shadows_clip": -4.0
      }
    },
    {
      "plugin": "stretch.auto",
      "params": {
        "target": 0.17,
        "shadows_clip": -5.0
      }
    },
    {
      "plugin": "color.neutralize_background"
    },
    {
      "plugin": "stars.remove_basic",
      "preview": true
    },
    {
      "plugin": "contrast.hdr",
      "params": {
        "amount": 0.4
      }
    },
    {
      "plugin": "contrast.local",
      "params": {
        "amount": 0.35
      }
    },
    {
      "plugin": "contrast.dark_structure",
      "params": {
        "amount": 0.5
      }
    },
    {
      "plugin": "contrast.saturation",
      "params": {
        "amount": 0.45,
        "masked": false
      }
    },
    {
      "plugin": "cosmetic.chroma_noise"
    },
    {
      "plugin": "stars.recombine",
      "params": {
        "amount": 0.85,
        "reduce": 0.5
      }
    },
    {
      "plugin": "color.neutralize_background"
    }
  ]
}