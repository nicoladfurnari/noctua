{
  "name": "nebula",
  "description": "Emission nebula in a rich star field (tested on M8). Built-in tools only.",
  "steps": [
    {
      "plugin": "crop.auto"
    },
    {
      "plugin": "cosmetic.hot_pixels"
    },
    {
      "plugin": "background.poly",
      "params": {
        "degree": 2
      }
    },
    {
      "plugin": "color.neutralize_background"
    },
    {
      "plugin": "color.white_balance_stars"
    },
    {
      "plugin": "color.fix_saturated"
    },
    {
      "plugin": "sharpen.deconvolution",
      "params": {
        "iterations": 10,
        "amount": 0.6
      }
    },
    {
      "plugin": "noise.wavelet"
    },
    {
      "plugin": "stretch.auto",
      "params": {
        "target": 0.08,
        "shadows_clip": -4.0
      }
    },
    {
      "plugin": "stretch.auto",
      "params": {
        "target": 0.17,
        "shadows_clip": -5.0
      },
      "preview": true
    },
    {
      "plugin": "color.neutralize_background"
    },
    {
      "plugin": "stars.reduce",
      "params": {
        "amount": 0.75
      }
    },
    {
      "plugin": "stars.halo_reduce",
      "params": {
        "amount": 0.4
      }
    },
    {
      "plugin": "color.scnr",
      "params": {
        "amount": 0.8
      }
    },
    {
      "plugin": "contrast.hdr",
      "params": {
        "amount": 0.4
      }
    },
    {
      "plugin": "contrast.local",
      "params": {
        "amount": 0.25
      }
    },
    {
      "plugin": "contrast.dark_structure",
      "params": {
        "amount": 0.4
      }
    },
    {
      "plugin": "contrast.curves"
    },
    {
      "plugin": "contrast.saturation",
      "params": {
        "amount": 0.35
      }
    },
    {
      "plugin": "stars.color_boost",
      "params": {
        "amount": 0.4
      }
    },
    {
      "plugin": "cosmetic.chroma_noise"
    },
    {
      "plugin": "color.neutralize_background"
    }
  ]
}