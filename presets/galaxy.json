{
  "name": "galaxy",
  "description": "Galaxies (tested on M31): gentle stretch, HDR core, natural star colors.",
  "steps": [
    {
      "plugin": "crop.auto"
    },
    {
      "plugin": "cosmetic.hot_pixels"
    },
    {
      "plugin": "background.poly",
      "params": {
        "degree": 2,
        "reject_sigma": 1.0
      }
    },
    {
      "plugin": "color.neutralize_background"
    },
    {
      "plugin": "color.white_balance_stars"
    },
    {
      "plugin": "color.fix_saturated",
      "params": {
        "start": 0.25
      }
    },
    {
      "plugin": "sharpen.deconvolution",
      "params": {
        "iterations": 10,
        "amount": 0.5
      }
    },
    {
      "plugin": "noise.wavelet"
    },
    {
      "plugin": "stretch.arcsinh",
      "params": {
        "beta": 150
      }
    },
    {
      "plugin": "stretch.auto",
      "params": {
        "target": 0.15,
        "shadows_clip": -5.0
      },
      "preview": true
    },
    {
      "plugin": "color.neutralize_background"
    },
    {
      "plugin": "contrast.hdr",
      "params": {
        "amount": 0.5,
        "threshold": 0.45,
        "scale": 64
      }
    },
    {
      "plugin": "contrast.local",
      "params": {
        "amount": 0.25
      }
    },
    {
      "plugin": "stars.reduce",
      "params": {
        "amount": 0.5
      }
    },
    {
      "plugin": "color.scnr",
      "params": {
        "amount": 0.6
      }
    },
    {
      "plugin": "contrast.curves"
    },
    {
      "plugin": "contrast.saturation",
      "params": {
        "amount": 0.4
      }
    },
    {
      "plugin": "cosmetic.chroma_noise"
    },
    {
      "plugin": "color.neutralize_background"
    }
  ]
}